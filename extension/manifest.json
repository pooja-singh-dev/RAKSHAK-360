{
  "manifest_version": 3,
  "name": "Rakshak-360",
  "version": "1.0",
  "description": "Aapka Cyber Security Rakshak",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rakshak-360"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}